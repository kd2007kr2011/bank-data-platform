
# Python 虚拟环境
.venv/
venv/

# 环境变量与敏感配置
.env
.env.*
!.env.example

# Python 缓存文件
__pycache__/
*.py[cod]

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 生成的合成数据（可随时由 scripts/generate/generate.py 重新生成）
scripts/data/generated/

# 日志文件
*.log

# VS Code 本地配置（如需共享配置可调整）
.vscode/*
!.vscode/extensions.json
